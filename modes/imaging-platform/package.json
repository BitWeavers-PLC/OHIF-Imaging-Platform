{
  "name": "@ohif/mode-imaging-platform",
  "version": "3.13.0-beta.24",
  "description": "Imaging Platform overlay mode built on top of basic mode",
  "author": "Imaging Platform",
  "license": "MIT",
  "main": "dist/ohif-mode-imaging-platform.js",
  "module": "src/index.ts",
  "files": [
    "dist/**",
    "README.md"
  ],
  "repository": "OHIF/Viewers",
  "keywords": [
    "ohif-mode"
  ],
  "engines": {
    "node": ">=14",
    "npm": ">=6",
    "yarn": ">=1.16.0"
  },
  "peerDependencies": {
    "@ohif/core": "3.13.0-beta.24",
    "@ohif/mode-basic": "3.13.0-beta.24"
  },
  "dependencies": {
    "@babel/runtime": "7.28.2"
  },
  "devDependencies": {
    "webpack": "5.105.0",
    "webpack-merge": "5.10.0"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development webpack --config .webpack/webpack.dev.js --watch --output-pathinfo",
    "build": "cross-env NODE_ENV=production webpack --config .webpack/webpack.prod.js",
    "build:package": "yarn run build",
    "start": "yarn run dev",
    "test:unit": "jest --watchAll",
    "test:unit:ci": "jest --ci --runInBand --collectCoverage --passWithNoTests"
  }
}
