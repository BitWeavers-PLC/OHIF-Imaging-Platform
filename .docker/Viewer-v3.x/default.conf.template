server {
  gzip_static  always;
  gzip_proxied expired no-cache no-store private auth;
  gunzip       on;
  listen ${PORT} default_server;
  listen [::]:${PORT} default_server;
  location / {
    root   /usr/share/nginx/html;
    index  index.html index.htm;
    try_files $uri $uri/ ${PUBLIC_URL}index.html;
    add_header Cross-Origin-Resource-Policy same-origin;
    # Unhashed files (index.html, app-config.js, sw.js...) revalidate every load.
    add_header Cache-Control no-cache;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
  }
  # Content-hashed bundles and codecs never change under the same name.
  location ~* "(\.[0-9a-f]{20}\.(js|css)|/[0-9a-f]{20}\.wasm)$" {
    root   /usr/share/nginx/html;
    add_header Cross-Origin-Resource-Policy same-origin;
    add_header Cache-Control "public, max-age=31536000, immutable";
  }
  error_page   500 502 503 504  /50x.html;
  location = /50x.html {
    root   /usr/share/nginx/html;
  }
}
